-- Resolve special Vars when execution-time pruning removes every child.
SET pg_qualstats.enabled = off;
SET pg_qualstats.sample_rate = 1;
SET plan_cache_mode = force_generic_plan;
SET enable_nestloop = off;
SET enable_mergejoin = off;
SET jit = off;
SET statement_timeout = '5s';
CREATE TABLE pruning_part (key integer, id integer, flag boolean)
    PARTITION BY RANGE (key);
CREATE TABLE pruning_part_1 PARTITION OF pruning_part
    FOR VALUES FROM (0) TO (10);
CREATE TABLE pruning_part_2 PARTITION OF pruning_part
    FOR VALUES FROM (10) TO (20);
CREATE TABLE pruning_lookup (id integer, flag boolean);
INSERT INTO pruning_part VALUES (1, 1, true), (11, 2, true);
INSERT INTO pruning_lookup VALUES (1, true), (2, true);
ANALYZE pruning_part;
ANALYZE pruning_lookup;
PREPARE pruning_join(integer) AS
SELECT p.id FROM pruning_part p JOIN pruning_lookup l ON p.id = l.id
WHERE p.key = $1;
SELECT "PGQS".pg_qualstats_reset();
 pg_qualstats_reset 
--------------------
 
(1 row)

SET pg_qualstats.enabled = on;
EXECUTE pruning_join(99);
 id 
----
(0 rows)

SET pg_qualstats.enabled = off;
-- Older servers retain an unexecuted child, whose Vars can still be resolved.
-- Neither case should produce a join with only one known relation.
SELECT count(*) = 0 AS no_partial_join FROM "PGQS".pg_qualstats
WHERE opno = '=(integer,integer)'::regoperator
  AND (lrelid = 'pruning_lookup'::regclass OR rrelid = 'pruning_lookup'::regclass)
  AND (lrelid IS NULL OR rrelid IS NULL);
 no_partial_join 
-----------------
 t
(1 row)

-- Reuse the same generic plan with a surviving partition.  Both sides of the
-- join must still resolve to their real relation and attribute.
SELECT "PGQS".pg_qualstats_reset();
 pg_qualstats_reset 
--------------------
 
(1 row)

SET pg_qualstats.enabled = on;
EXECUTE pruning_join(1);
 id 
----
  1
(1 row)

SET pg_qualstats.enabled = off;
SELECT count(*) = 1 AS resolved_join FROM "PGQS".pg_qualstats
WHERE (lrelid = 'pruning_part_1'::regclass AND lattnum = 2
       AND rrelid = 'pruning_lookup'::regclass AND rattnum = 1)
   OR (rrelid = 'pruning_part_1'::regclass AND rattnum = 2
       AND lrelid = 'pruning_lookup'::regclass AND lattnum = 1);
 resolved_join 
---------------
 t
(1 row)

-- A FULL JOIN keeps the BooleanTests and the resolvable sibling predicate at
-- the join node.  This also exercises hashing a group with unresolved Vars.
PREPARE pruning_group(integer) AS
SELECT p.id AS part_id, l.id AS lookup_id
FROM (SELECT * FROM pruning_part WHERE key = $1) p
FULL JOIN pruning_lookup l
    ON p.id = l.id AND p.flag IS TRUE AND l.flag IS TRUE AND l.id > 0
ORDER BY l.id;
SELECT "PGQS".pg_qualstats_reset();
 pg_qualstats_reset 
--------------------
 
(1 row)

SET pg_qualstats.enabled = on;
EXECUTE pruning_group(99);
 part_id | lookup_id 
---------+-----------
         |         1
         |         2
(2 rows)

SET pg_qualstats.enabled = off;
SELECT count(*) = 2 AS resolved_siblings FROM "PGQS".pg_qualstats
WHERE lrelid = 'pruning_lookup'::regclass AND rrelid IS NULL;
 resolved_siblings 
-------------------
 t
(1 row)

SELECT count(*) = 0 AS no_partial_join FROM "PGQS".pg_qualstats
WHERE opno = '=(integer,integer)'::regoperator
  AND (lrelid = 'pruning_lookup'::regclass OR rrelid = 'pruning_lookup'::regclass)
  AND (lrelid IS NULL OR rrelid IS NULL);
 no_partial_join 
-----------------
 t
(1 row)

-- Keep ordering below a Limit to exercise resolution through multiple plan
-- levels, including a MergeAppend when the server supports pruning it.
CREATE INDEX ON pruning_part (id);
SET enable_seqscan = off;
SET enable_sort = off;
PREPARE pruning_merge(integer) AS
SELECT p.id
FROM (SELECT id FROM pruning_part WHERE key >= $1 ORDER BY id LIMIT 100) p
JOIN pruning_lookup l ON p.id = l.id
ORDER BY p.id;
SELECT "PGQS".pg_qualstats_reset();
 pg_qualstats_reset 
--------------------
 
(1 row)

SET pg_qualstats.enabled = on;
EXECUTE pruning_merge(99);
 id 
----
(0 rows)

SET pg_qualstats.enabled = off;
SELECT "PGQS".pg_qualstats_reset();
 pg_qualstats_reset 
--------------------
 
(1 row)

SET pg_qualstats.enabled = on;
EXECUTE pruning_merge(1);
 id 
----
  1
  2
(2 rows)

SET pg_qualstats.enabled = off;
SELECT count(*) = 1 AS resolved_nested_join FROM "PGQS".pg_qualstats
WHERE (lrelid = 'pruning_part_1'::regclass AND lattnum = 2
       AND rrelid = 'pruning_lookup'::regclass AND rattnum = 1)
   OR (rrelid = 'pruning_part_1'::regclass AND rattnum = 2
       AND lrelid = 'pruning_lookup'::regclass AND lattnum = 1);
 resolved_nested_join 
----------------------
 t
(1 row)

DEALLOCATE pruning_join;
DEALLOCATE pruning_group;
DEALLOCATE pruning_merge;
DROP TABLE pruning_part, pruning_lookup;
RESET statement_timeout;
RESET enable_sort;
RESET enable_seqscan;
RESET jit;
RESET enable_mergejoin;
RESET enable_nestloop;
RESET plan_cache_mode;
RESET pg_qualstats.sample_rate;
RESET pg_qualstats.enabled;
